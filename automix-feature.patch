diff --git a/lib/helpers/automix/automix_analysis.dart b/lib/helpers/automix/automix_analysis.dart
new file mode 100644
index 0000000..6f5a303
--- /dev/null
+++ b/lib/helpers/automix/automix_analysis.dart
@@ -0,0 +1,163 @@
+import 'dart:math' as math;
+import 'dart:typed_data';
+
+/// Sample rate (mono) the analysis functions expect.
+const int analysisRate = 11025;
+const int _hop = 256;
+const int _win = 512;
+const double _fps = analysisRate / _hop;
+
+/// Estimates tempo and the first bar start from a mono drums stem.
+///
+/// Returns `{'bpm': .., 'downbeat': ..}` (seconds), or an empty map when no
+/// steady beat is found. Top-level so it can run through `compute`.
+Map<String, double> analyzeBeats(Float32List drums) {
+  final env = _onsetEnvelope(drums);
+  if (env.length < 200) return {};
+
+  var mean = 0.0;
+  for (final v in env) {
+    mean += v;
+  }
+  mean /= env.length;
+  if (mean <= 1e-9) return {};
+
+  final coarse = _search(env, 70, 180, 0.25, 0.5, usePrior: true);
+  final fine = _search(
+    env,
+    coarse.bpm - 0.5,
+    coarse.bpm + 0.5,
+    0.02,
+    0.25,
+    usePrior: false,
+  );
+  if (fine.score / mean < 1.3) return {};
+
+  final period = 60.0 * _fps / fine.bpm;
+  final sums = List<double>.filled(4, 0);
+  final counts = List<int>.filled(4, 0);
+  var k = 0;
+  for (var t = fine.phase; t < env.length - 1; t += period) {
+    final i = t.round();
+    var v = env[i];
+    if (i > 0) v = math.max(v, env[i - 1]);
+    if (i + 1 < env.length) v = math.max(v, env[i + 1]);
+    sums[k % 4] += v;
+    counts[k % 4]++;
+    k++;
+  }
+  var bar = 0;
+  var bestMean = -1.0;
+  for (var o = 0; o < 4; o++) {
+    final m = counts[o] == 0 ? 0.0 : sums[o] / counts[o];
+    if (m > bestMean) {
+      bestMean = m;
+      bar = o;
+    }
+  }
+  final frame = fine.phase + bar * period;
+  return {
+    'bpm': fine.bpm,
+    'downbeat': (frame * _hop + _win - _hop / 2) / analysisRate,
+  };
+}
+
+/// Start time (seconds) of the first silence of at least [minGap] seconds
+/// between [from] and [to] in a mono vocals stem, or null if there is none.
+double? findVocalGap(
+  Float32List vocals, {
+  required double from,
+  required double to,
+  double minGap = 0.4,
+}) {
+  const frameSeconds = 0.05;
+  final n = (frameSeconds * analysisRate).round();
+  final frames = vocals.length ~/ n;
+  if (frames < 20) return null;
+
+  final db = Float64List(frames);
+  for (var i = 0; i < frames; i++) {
+    var e = 0.0;
+    for (var k = 0; k < n; k++) {
+      final v = vocals[i * n + k];
+      e += v * v;
+    }
+    db[i] = 20 * math.log(math.sqrt(e / n) + 1e-9) / math.ln10;
+  }
+  final sorted = db.toList()..sort();
+  final ref = sorted[(frames * 0.9).floor().clamp(0, frames - 1).toInt()];
+  if (ref < -50) return null; // essentially no vocals
+  final threshold = ref - 25;
+  final need = (minGap / frameSeconds).ceil();
+
+  final a = (from / frameSeconds).floor().clamp(0, frames - 1).toInt();
+  final b = (to / frameSeconds).ceil().clamp(0, frames).toInt();
+  var run = 0;
+  for (var i = a; i < b; i++) {
+    if (db[i] < threshold) {
+      run++;
+      if (run >= need) return (i - run + 1) * frameSeconds;
+    } else {
+      run = 0;
+    }
+  }
+  return null;
+}
+
+Float64List _onsetEnvelope(Float32List x) {
+  final n = (x.length - _win) ~/ _hop;
+  if (n <= 0) return Float64List(0);
+  final env = Float64List(n);
+  var prev = 0.0;
+  var sum = 0.0;
+  for (var i = 0; i < n; i++) {
+    final s = i * _hop;
+    var e = 0.0;
+    for (var k = 0; k < _win; k++) {
+      final v = x[s + k];
+      e += v * v;
+    }
+    final level = math.log(1.0 + 1000.0 * math.sqrt(e / _win));
+    final d = level - prev;
+    prev = level;
+    env[i] = d > 0 ? d : 0;
+    sum += env[i];
+  }
+  final mean = sum / n;
+  for (var i = 0; i < n; i++) {
+    env[i] = math.max(0.0, env[i] - mean);
+  }
+  return env;
+}
+
+double _comb(Float64List env, double period, double phase) {
+  var s = 0.0;
+  var c = 0;
+  final last = env.length - 1;
+  for (var t = phase; t < last; t += period) {
+    s += env[t.round()];
+    c++;
+  }
+  return c == 0 ? 0 : s / c;
+}
+
+({double bpm, double phase, double score}) _search(
+  Float64List env,
+  double lo,
+  double hi,
+  double step,
+  double phaseStep, {
+  required bool usePrior,
+}) {
+  var best = (bpm: lo, phase: 0.0, score: -1.0);
+  for (var bpm = lo; bpm <= hi; bpm += step) {
+    final period = 60.0 * _fps / bpm;
+    final octaves = math.log(bpm / 120.0) / math.ln2;
+    final weight = usePrior ? math.exp(-0.5 * octaves * octaves / 0.36) : 1.0;
+    for (var ph = 0.0; ph < period; ph += phaseStep) {
+      final s = _comb(env, period, ph) * weight;
+      if (s > best.score) best = (bpm: bpm, phase: ph, score: s);
+    }
+  }
+  return best;
+}
diff --git a/lib/helpers/automix/automix_plan.dart b/lib/helpers/automix/automix_plan.dart
new file mode 100644
index 0000000..88f3b15
--- /dev/null
+++ b/lib/helpers/automix/automix_plan.dart
@@ -0,0 +1,201 @@
+import 'dart:math' as math;
+
+/// Gain breakpoints for one stem: `[seconds, gain]` pairs, linear in between.
+typedef GainCurve = List<List<double>>;
+
+class AutoMixException implements Exception {
+  AutoMixException(this.message);
+  final String message;
+
+  @override
+  String toString() => message;
+}
+
+/// Where and how two songs are blended. All times are in seconds.
+///
+/// Output timeline: `lead` seconds of the outgoing song alone, then the
+/// 32-beat `blend`, then `tail` seconds of the incoming song alone.
+class AutoMixPlan {
+  AutoMixPlan._({
+    required this.outBpm,
+    required this.inBpm,
+    required this.beat,
+    required this.exitTime,
+    required this.entryTime,
+    required this.lead,
+    required this.blend,
+    required this.tail,
+    required this.hold,
+    required this.ramp,
+    required this.startSpeed,
+    required this.vocalOutAt,
+    required this.vocalOutFade,
+    required this.vocalInAt,
+    required this.usedVocalGap,
+  });
+
+  static const int rampChunks = 8;
+
+  final double outBpm;
+  final double inBpm;
+  final double beat;
+
+  /// Outgoing source time that maps to the start of the blend.
+  final double exitTime;
+
+  /// Incoming source time that maps to the start of the blend.
+  final double entryTime;
+  final double lead;
+  final double blend;
+  final double tail;
+
+  /// Seconds the incoming song plays at [startSpeed] before easing back.
+  final double hold;
+
+  /// Seconds it takes the incoming song to return to normal speed.
+  final double ramp;
+  final double startSpeed;
+
+  /// Blend-relative times (seconds after the blend starts).
+  final double vocalOutAt;
+  final double vocalOutFade;
+  final double vocalInAt;
+  final bool usedVocalGap;
+
+  double get total => lead + blend + tail;
+  double get tailSegment => blend + tail - hold - ramp;
+
+  factory AutoMixPlan.create({
+    required double outBpm,
+    required double outDownbeat,
+    required double outDuration,
+    required double inBpm,
+    required double inDownbeat,
+    required double inDuration,
+    double? vocalGap,
+  }) {
+    final beat = 60.0 / outBpm;
+    final bar = beat * 4;
+    final blend = beat * 32;
+    final tail = beat * 16;
+
+    final lastStart = outDuration - 0.5 - blend;
+    if (lastStart < outDownbeat) {
+      throw AutoMixException(
+        'The outgoing song is too short for a 32-beat transition.',
+      );
+    }
+    final exit = outDownbeat + ((lastStart - outDownbeat) / bar).floor() * bar;
+    final lead = math.min(beat * 8, exit);
+
+    var speed = outBpm / inBpm;
+    while (speed > 1.41) {
+      speed /= 2;
+    }
+    while (speed < 0.71) {
+      speed *= 2;
+    }
+    speed = speed.clamp(0.6, 1.6).toDouble();
+
+    final hold = beat * 16;
+    final ramp = math.min(6.48, blend + tail - hold - 1.0);
+    final tailSegment = blend + tail - hold - ramp;
+    final needed = hold * speed + ramp * math.max(speed, 1.0) + tailSegment;
+    if (inDuration - inDownbeat < needed) {
+      throw AutoMixException('The incoming song is too short to blend into.');
+    }
+
+    final double outAt;
+    final double outFade;
+    if (vocalGap != null) {
+      outAt = (vocalGap - exit).clamp(blend * 0.25, blend * 0.9).toDouble();
+      outFade = 0.15;
+    } else {
+      outAt = blend * 0.5;
+      outFade = 0.8;
+    }
+    var inAt = math.max(outAt + 0.1, hold + ramp);
+    inAt = (inAt / bar).ceil() * bar;
+    inAt = math.min(inAt, blend + tail - 2.0);
+
+    return AutoMixPlan._(
+      outBpm: outBpm,
+      inBpm: inBpm,
+      beat: beat,
+      exitTime: exit,
+      entryTime: inDownbeat,
+      lead: lead,
+      blend: blend,
+      tail: tail,
+      hold: hold,
+      ramp: ramp,
+      startSpeed: speed,
+      vocalOutAt: outAt,
+      vocalOutFade: outFade,
+      vocalInAt: inAt,
+      usedVocalGap: vocalGap != null,
+    );
+  }
+
+  /// Gain of each outgoing stem over the output timeline.
+  Map<String, GainCurve> get outgoingCurves => {
+    'drums': [
+      [0, 1],
+      [lead + blend * 0.5, 1],
+      [lead + blend, 0],
+    ],
+    'bass': [
+      [0, 1],
+      [lead + blend * 0.5, 1],
+      [lead + blend * 0.5 + beat * 2, 0],
+    ],
+    'other': [
+      [0, 1],
+      [lead + blend * 0.25, 1],
+      [lead + blend, 0],
+    ],
+    'vocals': [
+      [0, 1],
+      [lead + vocalOutAt, 1],
+      [lead + vocalOutAt + vocalOutFade, 0],
+    ],
+  };
+
+  /// Gain of each incoming stem over the output timeline.
+  Map<String, GainCurve> get incomingCurves => {
+    'drums': [
+      [0, 0],
+      [lead, 0],
+      [lead + blend * 0.5, 1],
+    ],
+    'bass': [
+      [0, 0],
+      [lead + blend * 0.5, 0],
+      [lead + blend * 0.5 + beat * 2, 1],
+    ],
+    'other': [
+      [0, 0],
+      [lead + blend * 0.25, 0],
+      [lead + blend * 0.75, 1],
+    ],
+    'vocals': [
+      [0, 0],
+      [lead + vocalInAt, 0],
+      [lead + vocalInAt + 0.4, 1],
+    ],
+  };
+
+  static double gainAt(GainCurve curve, double t) {
+    if (t <= curve.first[0]) return curve.first[1];
+    for (var i = 0; i < curve.length - 1; i++) {
+      final a = curve[i];
+      final b = curve[i + 1];
+      if (t < b[0]) {
+        final span = b[0] - a[0];
+        if (span <= 0) return b[1];
+        return a[1] + (b[1] - a[1]) * (t - a[0]) / span;
+      }
+    }
+    return curve.last[1];
+  }
+}
diff --git a/lib/helpers/automix/automix_renderer.dart b/lib/helpers/automix/automix_renderer.dart
new file mode 100644
index 0000000..f4226a8
--- /dev/null
+++ b/lib/helpers/automix/automix_renderer.dart
@@ -0,0 +1,141 @@
+import 'dart:math' as math;
+
+import 'package:ffmpeg_kit_flutter_new_audio/ffmpeg_kit.dart';
+import 'package:ffmpeg_kit_flutter_new_audio/return_code.dart';
+import 'package:path/path.dart' as p;
+
+import '../../constants.dart';
+import '../../models/unmixed_song.dart';
+import 'automix_plan.dart';
+
+/// Renders an [AutoMixPlan] with one FFmpeg filter graph per stem.
+class AutoMixRenderer {
+  static const stemNames = ['drums', 'bass', 'other', 'vocals'];
+  static const _stems = {
+    'drums': Stem.drums,
+    'bass': Stem.bass,
+    'other': Stem.other,
+    'vocals': Stem.vocals,
+  };
+
+  /// Writes `drums/bass/other/vocals/mixture.wav` into [outDir] and returns
+  /// their paths by name. [onDone] gets the number of files finished so far.
+  Future<Map<String, String>> render({
+    required UnmixedSong outgoing,
+    required UnmixedSong incoming,
+    required AutoMixPlan plan,
+    required String outDir,
+    required void Function(int done) onDone,
+    required bool Function() isCancelled,
+  }) async {
+    final files = <String, String>{};
+    for (var i = 0; i < stemNames.length; i++) {
+      if (isCancelled()) return files;
+      final name = stemNames[i];
+      final stem = _stems[name]!;
+      final dest = p.join(outDir, '$name.wav');
+      await _run(
+        '-i ${_q(outgoing.getStem(stem))} -i ${_q(incoming.getStem(stem))} '
+        '-filter_complex ${_q(_stemFilter(plan, name))} '
+        '-map "[out]" -c:a pcm_s16le -ar 44100 -y ${_q(dest)}',
+      );
+      files[name] = dest;
+      onDone(i + 1);
+    }
+    if (isCancelled()) return files;
+
+    final mixture = p.join(outDir, 'mixture.wav');
+    final inputs = stemNames.map((n) => '-i ${_q(files[n]!)}').join(' ');
+    await _run(
+      '$inputs -filter_complex '
+      '${_q('[0:a][1:a][2:a][3:a]amix=inputs=4:normalize=0:dropout_transition=0,alimiter=limit=0.97[out]')} '
+      '-map "[out]" -c:a pcm_s16le -ar 44100 -y ${_q(mixture)}',
+    );
+    files['mixture'] = mixture;
+    onDone(stemNames.length + 1);
+    return files;
+  }
+
+  String _stemFilter(AutoMixPlan plan, String name) {
+    final total = plan.total;
+    final parts = <String>[];
+
+    // Outgoing: cut from the lead-in, apply gain, pad to the full length.
+    final outGain = gainExpression(plan.outgoingCurves[name]!);
+    parts.add(
+      '[0:a]atrim=start=${_f(plan.exitTime - plan.lead)}:duration=${_f(total)},'
+      "asetpts=PTS-STARTPTS,volume='$outGain':eval=frame,"
+      'apad,atrim=end=${_f(total)}[o]',
+    );
+
+    // Incoming: hold at the matched speed, ease back to 1.0 in small steps.
+    final chunks = <List<double>>[]; // [source start, source length, speed]
+    var src = plan.entryTime;
+    chunks.add([src, plan.hold * plan.startSpeed, plan.startSpeed]);
+    src += plan.hold * plan.startSpeed;
+    final step = plan.ramp / AutoMixPlan.rampChunks;
+    for (var k = 0; k < AutoMixPlan.rampChunks; k++) {
+      final speed =
+          plan.startSpeed +
+          (1.0 - plan.startSpeed) * (k + 0.5) / AutoMixPlan.rampChunks;
+      chunks.add([src, speed * step, speed]);
+      src += speed * step;
+    }
+    chunks.add([src, plan.tailSegment, 1.0]);
+
+    final n = chunks.length;
+    final splitLabels = List.generate(n, (i) => '[s$i]').join();
+    parts.add('[1:a]asplit=$n$splitLabels');
+    for (var i = 0; i < n; i++) {
+      final c = chunks[i];
+      final tempo = (c[2] - 1.0).abs() < 1e-6 ? '' : ',atempo=${_f(c[2])}';
+      parts.add(
+        '[s$i]atrim=start=${_f(c[0])}:duration=${_f(c[1])},'
+        'asetpts=PTS-STARTPTS$tempo[c$i]',
+      );
+    }
+    final cLabels = List.generate(n, (i) => '[c$i]').join();
+    final delay = (plan.lead * 1000).round();
+    final inGain = gainExpression(plan.incomingCurves[name]!);
+    parts.add(
+      '${cLabels}concat=n=$n:v=0:a=1[inraw]',
+    );
+    parts.add(
+      '[inraw]adelay=$delay|$delay,'
+      "volume='$inGain':eval=frame,apad,atrim=end=${_f(total)}[i]",
+    );
+
+    parts.add(
+      '[o][i]amix=inputs=2:normalize=0:dropout_transition=0,'
+      'alimiter=limit=0.97[out]',
+    );
+    return parts.join(';');
+  }
+
+  /// FFmpeg `volume` expression for a piecewise-linear gain curve.
+  static String gainExpression(GainCurve pts) {
+    var expr = _f(pts.last[1]);
+    for (var i = pts.length - 2; i >= 0; i--) {
+      final t0 = pts[i][0];
+      final g0 = pts[i][1];
+      final t1 = pts[i + 1][0];
+      final g1 = pts[i + 1][1];
+      final span = math.max(t1 - t0, 0.001);
+      expr =
+          'if(lt(t,${_f(t1)}),${_f(g0)}+(${_f(g1 - g0)})*(t-${_f(t0)})/${_f(span)},$expr)';
+    }
+    return 'if(lt(t,${_f(pts.first[0])}),${_f(pts.first[1])},$expr)';
+  }
+
+  Future<void> _run(String command) async {
+    final session = await FFmpegKit.execute(command);
+    final code = await session.getReturnCode();
+    if (!ReturnCode.isSuccess(code)) {
+      throw AutoMixException('Could not render the transition.');
+    }
+  }
+
+  static String _f(double v) => v.toStringAsFixed(4);
+
+  String _q(String value) => '"${value.replaceAll('"', '\\"')}"';
+}
